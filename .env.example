# =============================================================================
# JobeeLanka - Production Environment Variables & Credentials
# =============================================================================

# Public Site Configuration
NEXT_PUBLIC_APP_URL="https://www.jobeelanka.com"
PORT=3000

# 1. Supabase (Managed Postgres, Auth & Realtime)
# Required when connecting database on Vercel + Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Redis & Asynchronous Pipeline (Optional - Upstash)
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@ap1-fast-lion-12345.upstash.io:6379"

# 3. Private CV Object Storage (AWS S3 or Cloudflare R2)
# Required for PDPA No. 9 compliant encrypted candidate CV storage & 15m presigned URLs
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="jobeelanka-cv-vault-private"
S3_ACCESS_KEY_ID="YOUR_R2_OR_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="YOUR_R2_OR_S3_SECRET_KEY"

# 4. Telegram Job Broadcaster (Optional / Recommended)
# For automated vacancy broadcasting to the JobeeLanka Telegram channel
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHANNEL_ID="@jobeelanka"

# 5. WhatsApp Business Cloud API (Optional - wa.me deep links work with zero credentials)
WHATSAPP_API_TOKEN="YOUR_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"

# 6. ITPro.lk Partner Syndication API
# Request official credentials from info@itpro.lk
ITPRO_PARTNER_API_KEY="YOUR_APPROVED_ITPRO_API_KEY"

# 7. Google AdSense Publisher Credentials
# Client ID for authorized banner delivery (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"

